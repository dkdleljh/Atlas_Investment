# Atlas Investment 환경변수 예시
# 실제 API 키는 이 파일에 직접 적지 말고, 복사본 .env 또는 OS 보안 저장소에 저장하세요.

ATLAS_INVESTMENT_MODE=paper
ATLAS_INVESTMENT_KILL_SWITCH=0
ATLAS_DATA_VENDOR=hybrid
ATLAS_DATA_MAX_SYMBOLS=8
ATLAS_DATA_DAYS=260
ATLAS_INCLUDE_KR_SNAPSHOTS=0
ATLAS_USDKRW_REFERENCE_RATE=1380

# Korean Stock Search proxy
KSKILL_PROXY_BASE_URL=https://k-skill-proxy.nomadamas.org

# DART OpenAPI
# 발급: https://opendart.fss.or.kr/ 에서 인증키 신청
# 사용: export API_K_DART="발급받은_키" 또는 .env에 저장 후 source .env
API_K_DART=

# 토스증권 공식 Open API
# 문서: https://developers.tossinvest.com/llms.txt
# OpenAPI JSON: https://openapi.tossinvest.com/openapi-docs/latest/openapi.json
# Base server: https://openapi.tossinvest.com
# 토큰: OAuth2 Client Credentials Grant, POST /oauth2/token
TOSS_API_DOCS_URL=https://developers.tossinvest.com/llms.txt
TOSS_API_OPENAPI_SPEC_URL=https://openapi.tossinvest.com/openapi-docs/latest/openapi.json
TOSS_API_REST_BASE_URL=https://openapi.tossinvest.com
TOSS_API_KEY=
TOSS_SECRET_KEY=
# 선택사항: 비워두면 /api/v1/accounts에서 첫 BROKERAGE accountSeq를 자동 선택합니다.
TOSS_ACCOUNT_SEQ=
TOSS_API_TIMEOUT_SECONDS=10
TOSS_API_MAX_RETRIES=2
TOSS_API_RATE_LIMIT_ENABLED=1

# Toss read-only CLI가 별도 로그인/설치를 지원할 때만 사용합니다.
# Atlas Investment은 read-only 경로에서 주문 제출 명령을 호출하지 않습니다.
