[Unit]
Description=Atlas Investment supervised paper operations daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/zenith/Desktop/Atlas_Investment
ExecStart=/home/zenith/Desktop/Atlas_Investment/scripts/atlas_investment_daemon.sh
Restart=always
RestartSec=30
Environment=ATLAS_INVESTMENT_MODE=paper

[Install]
WantedBy=default.target
